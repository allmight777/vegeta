APP_NAME="CIF-Empreinte"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# CIF_DEMO active les seeders et écrans de calibration de démonstration ; false en concours final si besoin.
CIF_DEMO=true

DB_CONNECTION=sqlite
# Base unique SQLite pour ce MVP resserré (voir docs/DECISIONS.md) : aucune autre variable DB_* nécessaire.

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
# false en local/démo (démo servie en http sur le réseau de la salle) ; true si servi en https.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Clés de chiffrement des données d'identité — une par réseau, jamais commitées, jamais APP_KEY.
# Générées manuellement (32 octets aléatoires en base64) tant que la commande cles:generer n'existe pas.
# Format : CLE_RESEAU_<code_reseau_majuscule>. CLE_CIF_DEMO sert de repli pour la démo si aucune clé
# de réseau n'est définie (voir config/cles.php et docs/DECISIONS.md).
CLE_CIF_DEMO=
