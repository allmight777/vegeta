APP_NAME="CIF-Empreinte"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# CIF_DEMO active les seeders et écrans de calibration de démonstration ; false en concours final si besoin.
CIF_DEMO=true

DB_CONNECTION=sqlite
# Base unique SQLite pour ce MVP resserré (voir docs/DECISIONS.md) : aucune autre variable DB_* nécessaire.

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict
# false en local/démo (démo servie en http sur le réseau de la salle) ; true si servi en https.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Clés de chiffrement des données d'identité — une par réseau, jamais commitées, jamais APP_KEY.
# Générées manuellement (32 octets aléatoires en base64) tant que la commande cles:generer n'existe pas.
# Format : CLE_RESEAU_<code_reseau_majuscule>. CLE_CIF_DEMO sert de repli pour la démo si aucune clé
# de réseau n'est définie (voir config/cles.php et docs/DECISIONS.md).
CLE_CIF_DEMO=

# Vérification NPI / connecteur système existant (06_PROMPT_FORMULAIRE_CLIENT_ENRICHI §6-7).
# 'simulateur'/'local' par défaut : aucune API réelle n'est branchée pour ce hackathon
# (voir docs/DECISIONS.md). Ne pas renseigner les *_API_* tant qu'aucun accès réel n'existe.
KYC_VERIFICATEUR_NPI=simulateur
KYC_NPI_API_URL=
KYC_NPI_API_CLE=
KYC_CONNECTEUR_SYSTEME_EXISTANT=local
KYC_CORE_BANKING_API_URL=
KYC_CORE_BANKING_API_CLE=
# Nombre de passages de `npi:verifier-en-attente` sans connexion avant d'arrêter de
# réessayer (07_PROMPT_MODE_DEGRADE_NPI_OCR §2.4, source = demo).
KYC_NPI_TENTATIVES_MAX=20

# Extraction de documents (06_PROMPT §5, 07_PROMPT §4). L'OCR local (.docx en texte natif,
# reste en OCR via Tesseract pour PDF scanné/jpg/png) est le seul pipeline implémenté.
EXTRACTION_DRIVER=demo

# Détecteur de connectivité (07_PROMPT_MODE_DEGRADE_NPI_OCR §1-2) : URL de test légère,
# aucune connexion officielle CIF fournie (source = demo) — à remplacer par un endpoint
# réel dès qu'il existe (ex. l'API NPI elle-même).
RESEAU_URL_TEST_CONNECTIVITE=https://www.google.com/generate_204

# Assistant IA conformité (08_PROMPT_ASSISTANT_IA_CONFORMITE). Aucune dépendance à
# installer : sans clé, l'assistant répond via son simulateur local (base de
# connaissances resources/assistance/*.md), aucune erreur visible. Aucun fournisseur
# n'est mandaté : renseigner l'URL/clé/modèles d'une API de complétion de chat au choix
# de l'équipe (voir docs/DECISIONS.md).
ASSISTANCE_IA_API_URL=
ASSISTANCE_IA_API_CLE=
ASSISTANCE_IA_MODELES=
# true = force le simulateur même si une clé est configurée — recommandé pendant la
# démonstration devant le jury pour ne jamais dépendre du wifi de la salle.
ASSISTANCE_IA_FORCER_SIMULATEUR=false
